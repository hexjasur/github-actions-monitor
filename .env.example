# 1. GitHub Personal Access Token (PAT)
# Olish joyi: https://github.com/settings/tokens (classic)
# Ruxsatlar: repo, workflow
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# 2. Telegram Bot Token
# Olish joyi: Telegram @BotFather orqali /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 3. Sizning Telegram Chat ID
# Olish joyi: Telegram @userinfobot orqali /start bosing
TELEGRAM_CHAT_ID=123456789

# 4. Google Gemini API Key (Ixtiyoriy - xatolarni tahlil qilib maslahat berishi uchun)
# Olish joyi: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# 5. Muvaffaqiyatli (Success) bo'lgan runlar haqida ham xabar kelsinmi? (true yoki false)
NOTIFY_ON_SUCCESS=false
